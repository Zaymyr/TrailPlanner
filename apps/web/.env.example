# Required Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for trusted server routes; never expose this value publicly
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_IOS_APP_STORE_URL=

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
POSTHOG_ORGANIZER_ANALYTICS_ENDPOINT=organizer-racebook-analytics

# Optional email and AI integrations; all values below are server-only
RESEND_API_KEY=
RESEND_FROM=
OPENAI_API_KEY=
OPENAI_ORGANIZER_IMPORT_MODEL=gpt-4.1-mini

# Optional scheduled jobs and plan sharing
CRON_SECRET=
PLAN_SHARE_BASE_URL=http://localhost:3000
PLAN_SHARE_TOKEN_SECRET=
EXPO_ACCESS_TOKEN=

# Optional Stripe integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000
STRIPE_BILLING_RETURN_URL=http://localhost:3000
STRIPE_ORGANIZER_ESSENTIAL_PRICE_ID=
STRIPE_ORGANIZER_COMPLETE_PRICE_ID=
STRIPE_ORGANIZER_SIGNATURE_PRICE_ID=
STRIPE_ORGANIZER_ESSENTIAL_TO_COMPLETE_PRICE_ID=
STRIPE_ORGANIZER_ESSENTIAL_TO_SIGNATURE_PRICE_ID=
STRIPE_ORGANIZER_COMPLETE_TO_SIGNATURE_PRICE_ID=
STRIPE_ORGANIZER_CHECKOUT_SUCCESS_URL=http://localhost:3000
STRIPE_ORGANIZER_CHECKOUT_CANCEL_URL=http://localhost:3000

# Optional RevenueCat server integration
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ANDROID_SECRET_API_KEY=
REVENUECAT_IOS_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=Pace YourSelf Premium
REVENUECAT_IOS_ANNUAL_PRODUCT_ID=runner_premium_annual_v2
REVENUECAT_ANDROID_ANNUAL_PRODUCT_ID=runner_premium_annual_v2:annual
